{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "test-private/**/*.ts",
    "*.config.ts",
    "test-external/**/*.ts"
  ]
}
