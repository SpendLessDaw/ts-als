{
  "name": "ts-als",
  "version": "0.1.0-alpha.4",
  "description": "Experimental TypeScript library for reading Ableton Live ALS files, inspecting samples and plugins, and making targeted edits.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:fixtures": "vitest run --project private",
    "prepublishOnly": "bun run test && bun run typecheck && bun run lint && bun run build && bun run check:public && bun run check:package",
    "check:package": "node scripts/check-package.mjs",
    "check:public": "node scripts/check-public.mjs",
    "test:external": "vitest run --project external",
    "fixtures:fetch": "node scripts/fetch-public-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^24.10.13",
    "eslint": "9.39.2",
    "typescript-eslint": "8.53.1",
    "tsup": "8.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "saxes": "6.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpendLessDaw/ts-als.git"
  },
  "homepage": "https://github.com/SpendLessDaw/ts-als",
  "bugs": {
    "url": "https://github.com/SpendLessDaw/ts-als/issues"
  },
  "keywords": [
    "typescript",
    "javascript",
    "nodejs",
    "ableton",
    "ableton-live",
    "als",
    "parser",
    "daw",
    "samples",
    "audio",
    "music-production"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
